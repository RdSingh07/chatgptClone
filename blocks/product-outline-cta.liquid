{%- liquid
  assign bs = block.settings
  assign uid = block.id | replace: '_', '' | replace: '.', ''
  assign dlg = 'bds-cta-dlg-' | append: section.id | append: '-' | append: uid
  assign box_class = 'cus-outline-box product-outline-cta'
  if bs.hide_on_mobile
    assign box_class = box_class | append: ' hide-mobile'
  endif
-%}

{% if bs.heading != blank and bs.button_label != blank %}
  <div class="{{ box_class }}" {{ block.shopify_attributes }}>
    <p class="header">{{ bs.heading }}</p>

    {% if bs.open_mode == 'link' and bs.link_url != blank %}
      <a
        class="product-outline-cta__btn"
        href="{{ bs.link_url }}"
        {% if bs.open_new_tab %}
          target="_blank" rel="noopener noreferrer"
        {% endif %}
      >
        {% if bs.icon_style != 'none' %}
          <span class="product-outline-cta__ico" aria-hidden="true">
            {%- case bs.icon_style -%}
              {%- when 'image' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10.5" r="1.5"/><path d="M21 17l-5-5-4 4-2-2-4 4"/></svg>
              {%- when 'note' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v12l-4 4H4z"/><path d="M8 9h8M8 13h5"/></svg>
              {%- when 'file' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M12 18v-6M9 15h6"/></svg>
            {%- endcase -%}
          </span>
        {% endif %}
        <span class="product-outline-cta__label">{{ bs.button_label }}</span>
      </a>
    {% else %}
      <button type="button" class="product-outline-cta__btn" data-bds-cta-open="{{ dlg }}" aria-haspopup="dialog" aria-controls="{{ dlg }}">
        {% if bs.icon_style != 'none' %}
          <span class="product-outline-cta__ico" aria-hidden="true">
            {%- case bs.icon_style -%}
              {%- when 'image' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10.5" r="1.5"/><path d="M21 17l-5-5-4 4-2-2-4 4"/></svg>
              {%- when 'note' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v12l-4 4H4z"/><path d="M8 9h8M8 13h5"/></svg>
              {%- when 'file' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M12 18v-6M9 15h6"/></svg>
            {%- endcase -%}
          </span>
        {% endif %}
        <span class="product-outline-cta__label">{{ bs.button_label }}</span>
      </button>

      <dialog id="{{ dlg }}" class="product-outline-cta__dialog" aria-labelledby="{{ dlg }}-title">
        <div class="product-outline-cta__dialog-inner">
          <header class="product-outline-cta__dialog-head">
            <h2 id="{{ dlg }}-title" class="product-outline-cta__dialog-title">
              {{ bs.modal_heading | default: bs.heading }}
            </h2>
            <button type="button" class="product-outline-cta__dialog-x" data-bds-cta-close aria-label="{{ 'actions.close' | t }}">✕</button>
          </header>
          <div class="product-outline-cta__dialog-body rte">{{ bs.modal_body }}</div>
          {% if bs.support_email != blank %}
            <p class="product-outline-cta__dialog-actions">
              <a class="button" href="mailto:{{ bs.support_email | escape }}">{{ bs.email_button_label | default: 'Email us' }}</a>
            </p>
          {% endif %}
        </div>
      </dialog>

      <script>
        (function () {
          var id = {{ dlg | json }};
          var dlg = document.getElementById(id);
          if (!dlg || typeof dlg.showModal !== 'function') return;
          var root = dlg.closest('.product-outline-cta');
          if (!root) return;
          root.querySelectorAll('[data-bds-cta-open="' + id + '"]').forEach(function (btn) {
            btn.addEventListener('click', function () {
              dlg.showModal();
            });
          });
          root.querySelectorAll('[data-bds-cta-close]').forEach(function (btn) {
            btn.addEventListener('click', function () {
              dlg.close();
            });
          });
          dlg.addEventListener('click', function (e) {
            if (e.target === dlg) dlg.close();
          });
        })();
      </script>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .product-outline-cta.cus-outline-box {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .product-outline-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    max-width: 100%;
    padding: 0.65rem 1rem;
    background: #fff;
    color: #0a3161;
    border: 1px solid #0a3161;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.8125rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-family: inherit;
    cursor: pointer;
    text-align: center;
    line-height: 1.3;
  }

  .product-outline-cta__btn:hover {
    background: #f5f8fc;
  }

  .product-outline-cta__ico {
    display: inline-flex;
    flex-shrink: 0;
  }

  .product-outline-cta__dialog {
    max-width: min(520px, 100vw - 2rem);
    width: 100%;
    border: 1px solid #c8c8c8;
    border-radius: 6px;
    padding: 0;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.18);
  }

  .product-outline-cta__dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .product-outline-cta__dialog-inner {
    padding: 1rem 1.25rem 1.25rem;
  }

  .product-outline-cta__dialog-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .product-outline-cta__dialog-title {
    margin: 0;
    font-size: 1.1rem;
  }

  .product-outline-cta__dialog-x {
    border: none;
    background: none;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.15rem;
  }

  .product-outline-cta__dialog-body {
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .product-outline-cta__dialog-actions {
    margin: 1rem 0 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Outline CTA (mockup / quote)",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Box heading",
      "default": "Get Free 2D Mockup"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Get Free 2D Design Preview"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "image", "label": "Image / mockup" },
        { "value": "note", "label": "Document" },
        { "value": "file", "label": "File / quote" }
      ],
      "default": "image"
    },
    {
      "type": "select",
      "id": "open_mode",
      "label": "Button action",
      "options": [
        { "value": "dialog", "label": "Open modal" },
        { "value": "link", "label": "Go to link" }
      ],
      "default": "dialog"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL",
      "visible_if": "{{ block.settings.open_mode == 'link' }}"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open link in new tab",
      "default": false,
      "visible_if": "{{ block.settings.open_mode == 'link' }}"
    },
    {
      "type": "text",
      "id": "modal_heading",
      "label": "Modal title",
      "default": "Free 2D design preview",
      "visible_if": "{{ block.settings.open_mode == 'dialog' }}"
    },
    {
      "type": "richtext",
      "id": "modal_body",
      "label": "Modal content",
      "default": "<p>Share your logo and size details. Our team will email a free 2D mockup before printing.</p>",
      "visible_if": "{{ block.settings.open_mode == 'dialog' }}"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email (mailto button)",
      "default": "support@backdropsource.in",
      "visible_if": "{{ block.settings.open_mode == 'dialog' }}"
    },
    {
      "type": "text",
      "id": "email_button_label",
      "label": "Email button label",
      "default": "Email us",
      "visible_if": "{{ block.settings.open_mode == 'dialog' }}"
    }
  ],
  "presets": [
    {
      "name": "Outline CTA",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
