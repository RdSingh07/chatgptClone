{%- liquid
  assign bs = block.settings
  assign show_1 = bs.show_box_1
  assign show_2 = bs.show_box_2
-%}

{% if show_1 or show_2 %}
  <div class="product-outline-links spacing-style" style="{% render 'spacing-style', settings: bs %}" {{ block.shopify_attributes }}>
    {% if show_1 and bs.box_1_label != blank and bs.box_1_url != blank %}
      <div
        class="
          product-outline-links__box
          cus-outline-box
          {% if bs.box_1_hide_mobile %} hide-mobile{% endif %}
          {% if bs.box_1_border == 'accent' %} cus-outline-box--accent-border{% endif %}
        "
      >
        {% if bs.box_1_header != blank %}
          <p class="header" role="heading" aria-level="3">{{ bs.box_1_header }}</p>
        {% endif %}
        <a class="product-outline-links__btn btn setup-instruction" href="{{ bs.box_1_url }}" {% if bs.box_1_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
          <span class="product-outline-links__btn-ico" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v12l-4 4H4z"/><path d="M8 9h8M8 13h5"/></svg>
          </span>
          {{ bs.box_1_label }}
        </a>
      </div>
    {% endif %}

    {% if show_2 and bs.box_2_label != blank and bs.box_2_url != blank %}
      <div
        class="
          product-outline-links__box
          cus-outline-box
          {% if bs.box_2_hide_mobile %} hide-mobile{% endif %}
          {% if bs.box_2_border == 'accent' %} cus-outline-box--accent-border{% endif %}
        "
      >
        {% if bs.box_2_header != blank %}
          <p class="header" role="heading" aria-level="3">{{ bs.box_2_header }}</p>
        {% endif %}
        <a class="product-outline-links__btn btn" href="{{ bs.box_2_url }}" {% if bs.box_2_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
          <span class="product-outline-links__btn-ico" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M12 18v-6M9 15h6"/></svg>
          </span>
          {{ bs.box_2_label }}
        </a>
      </div>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .product-outline-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .product-outline-links__box.cus-outline-box {
    margin-top: 1rem;
    margin-bottom: 1rem;
    padding: 0 2.5rem 1.5rem;
    border: 1px dashed #aeaeae;
    border-radius: 4px;
    background: var(--color-background);
  }

  .product-outline-links__box.cus-outline-box.cus-outline-box--accent-border {
    border-color: #c62828;
    border-width: 2px;
  }

  .product-outline-links__box .header {
    display: block;
    color: #ff935b;
    font-weight: 700;
    font-size: 1rem;
    margin: 0 0 -10px;
    padding: 0 10px;
    position: relative;
    top: -15px;
    left: -25px;
    width: fit-content;
    max-width: 100%;
    background: var(--color-background);
    line-height: 1.3;
  }

  .product-outline-links__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 100%;
    padding: 0.7rem 1rem;
    background: #fff;
    color: #0a3161;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    border: 1px solid #0a3161;
    border-radius: 6px;
    text-align: center;
    line-height: 1.3;
    box-sizing: border-box;
  }

  .product-outline-links__btn:hover {
    background: #f5f8fc;
  }

  .product-outline-links__btn-ico {
    display: inline-flex;
    flex-shrink: 0;
    vertical-align: middle;
  }

  @media screen and (max-width: 749px) {
    .product-outline-links__box.cus-outline-box {
      padding: 0 1.25rem 1.25rem;
    }

    .product-outline-links__box .header {
      left: -12px;
      top: -12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Template & quote links",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "First box"
    },
    {
      "type": "checkbox",
      "id": "show_box_1",
      "label": "Show first box",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "box_1_hide_mobile",
      "label": "Hide first box on mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "box_1_border",
      "label": "First box border",
      "options": [
        {
          "value": "neutral",
          "label": "Gray dashed"
        },
        {
          "value": "accent",
          "label": "Red dashed"
        }
      ],
      "default": "neutral"
    },
    {
      "type": "text",
      "id": "box_1_header",
      "label": "Heading",
      "default": "Graphics Templates & Setup Guide"
    },
    {
      "type": "text",
      "id": "box_1_label",
      "label": "Link text",
      "default": "Design Template & Assembly Guide"
    },
    {
      "type": "url",
      "id": "box_1_url",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "box_1_new_tab",
      "label": "Open in new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Second box"
    },
    {
      "type": "checkbox",
      "id": "show_box_2",
      "label": "Show second box",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "box_2_hide_mobile",
      "label": "Hide second box on mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "box_2_border",
      "label": "Second box border",
      "options": [
        {
          "value": "neutral",
          "label": "Gray dashed"
        },
        {
          "value": "accent",
          "label": "Red dashed"
        }
      ],
      "default": "neutral"
    },
    {
      "type": "text",
      "id": "box_2_header",
      "label": "Heading",
      "default": "Get a Custom Size Quote"
    },
    {
      "type": "text",
      "id": "box_2_label",
      "label": "Link text",
      "default": "Get a Custom Size Quote"
    },
    {
      "type": "url",
      "id": "box_2_url",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "box_2_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Template & quote links",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
