{%- liquid
  assign bs = block.settings
  assign show_1 = bs.show_box_1
  assign show_2 = bs.show_box_2
-%}

{% if show_1 or show_2 %}
  <div class="product-outline-links spacing-style" style="{% render 'spacing-style', settings: bs %}" {{ block.shopify_attributes }}>
    {% if show_1 and bs.box_1_label != blank and bs.box_1_url != blank %}
      <div
        class="
          product-outline-links__box
          cus-outline-box
          {% if bs.box_1_hide_mobile %} hide-mobile{% endif %}
          {% if bs.box_1_border == 'accent' %} cus-outline-box--accent-border{% endif %}
        "
      >
        {% if bs.box_1_header != blank %}
          <span class="header">{{ bs.box_1_header }}</span>
        {% endif %}
        <a class="product-outline-links__btn btn setup-instruction" href="{{ bs.box_1_url }}" {% if bs.box_1_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
          {{ bs.box_1_label }}
        </a>
      </div>
    {% endif %}

    {% if show_2 and bs.box_2_label != blank and bs.box_2_url != blank %}
      <div
        class="
          product-outline-links__box
          cus-outline-box
          {% if bs.box_2_hide_mobile %} hide-mobile{% endif %}
          {% if bs.box_2_border == 'accent' %} cus-outline-box--accent-border{% endif %}
        "
      >
        {% if bs.box_2_header != blank %}
          <span class="header">{{ bs.box_2_header }}</span>
        {% endif %}
        <a class="product-outline-links__btn btn" href="{{ bs.box_2_url }}" {% if bs.box_2_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
          {{ bs.box_2_label }}
        </a>
      </div>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .product-outline-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .product-outline-links__box.cus-outline-box {
    margin-top: 0;
    margin-bottom: 0;
    padding: 1.25rem 1.5rem 1.5rem;
    border: 1px dashed #aeaeae;
    border-radius: 4px;
  }

  .product-outline-links__box.cus-outline-box.cus-outline-box--accent-border {
    border-color: #c62828;
    border-width: 2px;
  }

  .product-outline-links__box .header {
    display: block;
    color: #ff935b;
    font-weight: 700;
    font-size: 1rem;
    margin: 0 0 0.75rem;
    width: fit-content;
    max-width: 100%;
  }

  .product-outline-links__btn {
    display: inline-block;
    padding: 0.65rem 1rem;
    background: #e0e0e0;
    color: var(--color-foreground);
    text-decoration: none;
    font-weight: 600;
    border-radius: 4px;
  }

  .product-outline-links__btn:hover {
    opacity: 0.9;
  }

  @media screen and (max-width: 749px) {
    .product-outline-links__box.cus-outline-box {
      padding: 1rem 1rem 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Template & quote links",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "First box"
    },
    {
      "type": "checkbox",
      "id": "show_box_1",
      "label": "Show first box",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "box_1_hide_mobile",
      "label": "Hide first box on mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "box_1_border",
      "label": "First box border",
      "options": [
        {
          "value": "neutral",
          "label": "Gray dashed"
        },
        {
          "value": "accent",
          "label": "Red dashed"
        }
      ],
      "default": "accent"
    },
    {
      "type": "text",
      "id": "box_1_header",
      "label": "Heading",
      "default": "Graphics Templates & Setup Guide"
    },
    {
      "type": "text",
      "id": "box_1_label",
      "label": "Link text",
      "default": "Design Template & Assembly Guide"
    },
    {
      "type": "url",
      "id": "box_1_url",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "box_1_new_tab",
      "label": "Open in new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Second box"
    },
    {
      "type": "checkbox",
      "id": "show_box_2",
      "label": "Show second box",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "box_2_hide_mobile",
      "label": "Hide second box on mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "box_2_border",
      "label": "Second box border",
      "options": [
        {
          "value": "neutral",
          "label": "Gray dashed"
        },
        {
          "value": "accent",
          "label": "Red dashed"
        }
      ],
      "default": "accent"
    },
    {
      "type": "text",
      "id": "box_2_header",
      "label": "Heading",
      "default": "Get a Custom Size Quote"
    },
    {
      "type": "text",
      "id": "box_2_label",
      "label": "Link text",
      "default": "Get a Custom Size Quote"
    },
    {
      "type": "url",
      "id": "box_2_url",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "box_2_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Template & quote links",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
