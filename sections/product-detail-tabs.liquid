{%- liquid
  assign s = section.settings
  assign uid = section.id | replace: '_', '' | replace: '.', ''
  if uid == blank
    assign uid = section.id
  endif
-%}

<div
  class="product-detail-tabs spacing-style section section--{{ s.section_width }} color-{{ s.color_scheme }}"
  id="product-detail-tabs-{{ section.id }}"
  style="{% render 'spacing-style', settings: s %}"
  {{ section.shopify_attributes }}
>
  <div class="section-background color-{{ s.color_scheme }}"></div>
  <div class="product-detail-tabs__inner{% if s.section_width == 'page-width' %} page-width{% endif %}">
    {%- comment -%}
      Do not use .visually-hidden on radios: this theme shows .visually-hidden on :focus/:active,
      which exposes the radio control. Match source (text.txt): display:none on tab radios.
    {%- endcomment -%}
    <div class="product-detail-tabs__chrome">
      <input
        class="product-detail-tabs__radio"
        type="radio"
        name="product-detail-tabs-{{ section.id }}"
        id="pdtr-{{ uid }}-1"
        checked
      >
      <input
        class="product-detail-tabs__radio"
        type="radio"
        name="product-detail-tabs-{{ section.id }}"
        id="pdtr-{{ uid }}-2"
      >
      <input
        class="product-detail-tabs__radio"
        type="radio"
        name="product-detail-tabs-{{ section.id }}"
        id="pdtr-{{ uid }}-3"
      >
      <input
        class="product-detail-tabs__radio"
        type="radio"
        name="product-detail-tabs-{{ section.id }}"
        id="pdtr-{{ uid }}-4"
      >

      <div class="tab-labels product-detail-tabs__labels" role="tablist" aria-label="{{ s.aria_label | escape }}">
        <label class="tab-label product-detail-tabs__label" for="pdtr-{{ uid }}-1" role="tab">{{ s.tab_1_label }}</label>
        <label class="tab-label product-detail-tabs__label" for="pdtr-{{ uid }}-2" role="tab">{{ s.tab_2_label }}</label>
        <label class="tab-label product-detail-tabs__label" for="pdtr-{{ uid }}-3" role="tab">{{ s.tab_3_label }}</label>
        <label class="tab-label product-detail-tabs__label" for="pdtr-{{ uid }}-4" role="tab">{{ s.tab_4_label }}</label>
      </div>

      <div
        class="tab-content rte product-detail-tabs__panel"
        id="pdtc-{{ uid }}-1"
        role="tabpanel"
      >
        {% render 'product-detail-tabs-panel', tab_index: 1, content: s.tab_1_content %}
      </div>
      <div
        class="tab-content rte product-detail-tabs__panel"
        id="pdtc-{{ uid }}-2"
        role="tabpanel"
      >
        {% render 'product-detail-tabs-panel', tab_index: 2, content: s.tab_2_content %}
      </div>
      <div
        class="tab-content rte product-detail-tabs__panel"
        id="pdtc-{{ uid }}-3"
        role="tabpanel"
      >
        {% render 'product-detail-tabs-panel', tab_index: 3, content: s.tab_3_content %}
      </div>
      <div
        class="tab-content rte product-detail-tabs__panel"
        id="pdtc-{{ uid }}-4"
        role="tabpanel"
      >
        {% render 'product-detail-tabs-panel', tab_index: 4, content: s.tab_4_content %}
      </div>
    </div>
  </div>
</div>

{% style %}
  #product-detail-tabs-{{ section.id }} .product-detail-tabs__inner {
    padding-block: 0.25rem;
  }

  #product-detail-tabs-{{ section.id }} .product-detail-tabs__chrome {
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.06);
  }

  /* Always hidden — labels drive selection */
  #product-detail-tabs-{{ section.id }} .product-detail-tabs__radio {
    /* stylelint-disable-next-line declaration-no-important */
    display: none !important;
  }

  #product-detail-tabs-{{ section.id }} .tab-labels {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0;
    margin: 0;
    padding: 12px 12px 0;
    font-family: var(--font-body--family, Arial, sans-serif);
    background: #ebebeb;
    border-bottom: 1px solid #c8c8c8;
  }

  #product-detail-tabs-{{ section.id }} .tab-label {
    position: relative;
    z-index: 0;
    padding: 11px 18px;
    margin: 0 5px -1px 0;
    cursor: pointer;
    border: 1px solid #c4c4c4;
    border-bottom: 1px solid #c8c8c8;
    background: #e3e3e3;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    user-select: none;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
    color: #333;
    transition: background 0.15s ease, color 0.15s ease;
  }

  #product-detail-tabs-{{ section.id }} .tab-label:hover {
    background: #d8d8d8;
  }

  #product-detail-tabs-{{ section.id }} .tab-content {
    display: none;
    margin: 0;
    padding: 22px 24px 26px;
    border: none;
    background: #fff;
    color: #222;
  }

  #product-detail-tabs-{{ section.id }} .product-detail-tabs__panel :first-child {
    margin-top: 0;
  }

  #product-detail-tabs-{{ section.id }} .product-detail-tabs__panel h1,
  #product-detail-tabs-{{ section.id }} .product-detail-tabs__panel h2,
  #product-detail-tabs-{{ section.id }} .product-detail-tabs__panel h3,
  #product-detail-tabs-{{ section.id }} .product-detail-tabs__panel h4 {
    color: #0a3161;
    font-weight: 700;
    margin-top: 1.25rem;
    margin-bottom: 0.65rem;
    font-size: 1.0625rem;
  }

  #product-detail-tabs-{{ section.id }} .product-detail-tabs__panel h4:first-child {
    margin-top: 0;
  }

  #product-detail-tabs-{{ section.id }} .product-detail-tabs__panel p {
    margin-top: 0;
    margin-bottom: 0.85rem;
    line-height: 1.55;
  }

  #product-detail-tabs-{{ section.id }} .product-detail-tabs__panel ul {
    margin: 0 0 1rem;
    padding-left: 1.35rem;
    line-height: 1.55;
  }

  #product-detail-tabs-{{ section.id }} .product-detail-tabs__panel li {
    margin-bottom: 0.4rem;
  }

  #product-detail-tabs-{{ section.id }} .product-detail-tabs__panel a {
    color: #0a3161;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #product-detail-tabs-{{ section.id }} .product-detail-tabs__panel a:hover {
    color: #0d4a8c;
  }

  /* Active tab: white, bold, seam into panel */
  #product-detail-tabs-{{ section.id }} #pdtr-{{ uid }}-1:checked ~ .tab-labels label[for='pdtr-{{ uid }}-1'],
  #product-detail-tabs-{{ section.id }} #pdtr-{{ uid }}-2:checked ~ .tab-labels label[for='pdtr-{{ uid }}-2'],
  #product-detail-tabs-{{ section.id }} #pdtr-{{ uid }}-3:checked ~ .tab-labels label[for='pdtr-{{ uid }}-3'],
  #product-detail-tabs-{{ section.id }} #pdtr-{{ uid }}-4:checked ~ .tab-labels label[for='pdtr-{{ uid }}-4'] {
    z-index: 2;
    background: #fff;
    font-weight: 700;
    color: #0a3161;
    border-color: #c8c8c8;
    border-bottom-color: #fff;
    margin-bottom: -1px;
  }

  #product-detail-tabs-{{ section.id }} #pdtr-{{ uid }}-1:checked ~ #pdtc-{{ uid }}-1,
  #product-detail-tabs-{{ section.id }} #pdtr-{{ uid }}-2:checked ~ #pdtc-{{ uid }}-2,
  #product-detail-tabs-{{ section.id }} #pdtr-{{ uid }}-3:checked ~ #pdtc-{{ uid }}-3,
  #product-detail-tabs-{{ section.id }} #pdtr-{{ uid }}-4:checked ~ #pdtc-{{ uid }}-4 {
    display: block;
  }

  @media screen and (max-width: 767px) {
    #product-detail-tabs-{{ section.id }} .tab-labels {
      flex-direction: column;
      align-items: stretch;
      padding: 8px 8px 0;
    }

    #product-detail-tabs-{{ section.id }} .tab-label {
      width: 100%;
      margin-right: 0;
      margin-bottom: 0;
      border-radius: 4px 4px 0 0;
      border-bottom: 1px solid #c8c8c8;
      text-align: left;
    }

    #product-detail-tabs-{{ section.id }} #pdtr-{{ uid }}-1:checked ~ .tab-labels label[for='pdtr-{{ uid }}-1'],
    #product-detail-tabs-{{ section.id }} #pdtr-{{ uid }}-2:checked ~ .tab-labels label[for='pdtr-{{ uid }}-2'],
    #product-detail-tabs-{{ section.id }} #pdtr-{{ uid }}-3:checked ~ .tab-labels label[for='pdtr-{{ uid }}-3'],
    #product-detail-tabs-{{ section.id }} #pdtr-{{ uid }}-4:checked ~ .tab-labels label[for='pdtr-{{ uid }}-4'] {
      background: #fff;
      border-bottom-color: #c8c8c8;
      margin-bottom: 0;
    }

    #product-detail-tabs-{{ section.id }} .tab-content {
      padding: 18px 16px 22px;
      border-top: 1px solid #c8c8c8;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Product detail tabs",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "paragraph",
      "content": "CSS-only tabs (radio + labels) matching Backdrop Source product description. Leave a tab’s content empty to use the built-in default copy for that tab."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Tabs accessible name",
      "default": "Product information tabs"
    },
    {
      "type": "header",
      "content": "Tab 1"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Label",
      "default": "Overview & Details"
    },
    {
      "type": "richtext",
      "id": "tab_1_content",
      "label": "Content (optional override)"
    },
    {
      "type": "header",
      "content": "Tab 2"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Label",
      "default": "Product Dimensions"
    },
    {
      "type": "richtext",
      "id": "tab_2_content",
      "label": "Content (optional override)"
    },
    {
      "type": "header",
      "content": "Tab 3"
    },
    {
      "type": "text",
      "id": "tab_3_label",
      "label": "Label",
      "default": "What's Included"
    },
    {
      "type": "richtext",
      "id": "tab_3_content",
      "label": "Content (optional override)"
    },
    {
      "type": "header",
      "content": "Tab 4"
    },
    {
      "type": "text",
      "id": "tab_4_label",
      "label": "Label",
      "default": "Artwork & File Setup"
    },
    {
      "type": "richtext",
      "id": "tab_4_content",
      "label": "Content (optional override)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product detail tabs",
      "category": "Product"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
